# move.fragment.config
#
# Kernel config fragment for the Ableton Move on either CM4 (BCM2711) or
# CM5 (BCM2712). Reconstructed from the stock 5.15.92-rt57-v8 kernel's
# modules.builtin (364 entries) + modules.alias + the live lsmod (27
# loaded modules) listing pulled from the device.
#
# CONFIG_IKCONFIG was OFF in the stock build, so neither /proc/config.gz
# nor an IKCFG_ST marker in the kernel Image was available. The fragment
# below is therefore a *behavioural* reconstruction: every CONFIG entry
# is justified by an observed-on-device artefact (a built-in driver, a
# loaded module, a /sys node, an /etc/init.d hook). The set is sufficient
# to recreate the Move's runtime; it is *not* a byte-exact byte for byte
# reproduction of Ableton's .config.
#
# Usage (standalone, against a raspberrypi/linux checkout):
#   cd linux-rpi-6.18.y    # current as of mid-2026; rpi-7.0.y for edge
#   make ARCH=arm64 CROSS_COMPILE=aarch64-linux-gnu- bcm2711_defconfig    # CM4
#       # or bcm2712_defconfig for CM5
#   ./scripts/kconfig/merge_config.sh -m .config \
#       ../port/kernel-config/move.fragment.config
#   make ARCH=arm64 CROSS_COMPILE=aarch64-linux-gnu- olddefconfig
#
# Usage (under Armbian-build): place this file at
# userpatches/move.fragment.config — the move-kernel-config extension
# (custom_kernel_config__merge_move_fragment) merges it automatically.
#
# PREEMPT_RT is mandatory for the audio loop. As of rpi-6.18.y the rt
# patches are upstream-mergeable; older branches need rt-stable's patches
# applied first (see https://wiki.linuxfoundation.org/realtime/start).

# ─── Real-time scheduling ────────────────────────────────────────────────
CONFIG_PREEMPT_RT=y
CONFIG_PREEMPT_DYNAMIC=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_HZ_1000=y
CONFIG_HZ=1000
CONFIG_NO_HZ_FULL=y
CONFIG_RCU_NOCB_CPU=y

# RT_GROUP_SCHED is the canonical "good for containers, bad for audio"
# option: when enabled, every SCHED_FIFO/RR thread must live in a cgroup
# with an explicit cpu.rt_runtime_us allocation or it gets denied
# scheduling / throttled mid-buffer, which is fatal for the Move's audio
# loop. Disable it - Ubuntu Studio, KXStudio, AVLinux, Bela all ship
# with this off. We don't run RT-aware container workloads on Move, so
# we lose nothing.
# CONFIG_RT_GROUP_SCHED is not set

# Keep CFS bandwidth control (non-RT cgroups, generally useful and not
# audio-hostile) and the scheduler debug knobs.
CONFIG_CFS_BANDWIDTH=y
CONFIG_SCHED_DEBUG=y
CONFIG_SCHEDSTATS=y
CONFIG_TASKSTATS=y
CONFIG_TASK_DELAY_ACCT=y
CONFIG_TASK_XACCT=y
CONFIG_TASK_IO_ACCOUNTING=y

# Preempt-RT auto-selects threaded IRQs and PREEMPT_RCU. Make the intent
# explicit so a future kconfig refactor doesn't silently drop them.
CONFIG_IRQ_FORCED_THREADING=y
CONFIG_PREEMPT_RCU=y

# ─── SMP ─────────────────────────────────────────────────────────────────
CONFIG_SMP=y
CONFIG_NR_CPUS=4

# ─── Power / thermal ─────────────────────────────────────────────────────
CONFIG_PM=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_THERMAL=y
CONFIG_BCM2835_THERMAL=y

# ─── Memory / swap (zswap is in builtin list) ────────────────────────────
CONFIG_SWAP=y
CONFIG_ZSWAP=y
CONFIG_Z3FOLD=y
CONFIG_ZSMALLOC=y
CONFIG_CMA=y

# ─── Storage / MMC ───────────────────────────────────────────────────────
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_IPROC=y
CONFIG_MMC_BCM2835=y

# ─── Filesystems (ext4/vfat/f2fs/nfs are builtin in stock) ───────────────
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_QUOTA=y
CONFIG_QFMT_V2=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_F2FS_FS=y
CONFIG_NFS_FS=y
CONFIG_NFS_V3=y
CONFIG_NFS_V4=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_CONFIGFS_FS=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_CACHEFILES=y
CONFIG_FSCACHE=y
CONFIG_NETFS_SUPPORT=y
CONFIG_AUTOFS4_FS=y

# ─── NLS code pages (FAT mount needs cp437/iso8859) ──────────────────────
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ASCII=y
CONFIG_NLS_ISO8859_1=y

# ─── SPI (ablspi needs spi-bcm2835) ──────────────────────────────────────
CONFIG_SPI=y
CONFIG_SPI_MASTER=y
CONFIG_SPI_BCM2835=m
CONFIG_SPI_BCM2835AUX=m
CONFIG_SPI_SPIDEV=m

# ─── I2C (RTC + carrier sensors) ─────────────────────────────────────────
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=m
CONFIG_I2C_MUX=m
CONFIG_I2C_MUX_PINCTRL=m
CONFIG_I2C_BCM2835=m

# ─── GPIO ────────────────────────────────────────────────────────────────
CONFIG_GPIOLIB=y
CONFIG_GPIO_SYSFS=y
CONFIG_GPIO_RASPBERRYPI_EXP=y
CONFIG_GPIO_BCM_VIRT=y

# ─── RTC (Move ships NXP PCF85063) ───────────────────────────────────────
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_PCF85063=y

# ─── USB host / OTG / gadget ─────────────────────────────────────────────
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_USB_DWC2=m
CONFIG_USB_DWC2_DUAL_ROLE=y
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=m
CONFIG_USB_CONFIGFS=m
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_F_NCM=m
CONFIG_USB_F_FS=m
CONFIG_USB_ETH=m
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y

# ─── Ethernet (CM4 onboard Broadcom) ─────────────────────────────────────
CONFIG_NET_VENDOR_BROADCOM=y
CONFIG_BCMGENET=y
CONFIG_BROADCOM_PHY=y
CONFIG_USB_LAN78XX=y
CONFIG_USB_NET_SMSC95XX=y

# ─── Wireless: Intel WiFi over PCIe (Move uses an Intel card) ────────────
CONFIG_WLAN=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_IWLWIFI=m
CONFIG_IWLDVM=m
CONFIG_IWLMVM=m
CONFIG_LIBARC4=m

# ─── IPv6 ───────────────────────────────────────────────────────────────
CONFIG_IPV6=m

# ─── Watchdog ───────────────────────────────────────────────────────────
CONFIG_WATCHDOG=y
CONFIG_BCM2835_WDT=y

# ─── HW monitoring ───────────────────────────────────────────────────────
CONFIG_SENSORS_RASPBERRYPI_HWMON=m

# ─── UIO (uio_pdrv_genirq loaded in lsmod) ───────────────────────────────
CONFIG_UIO=m
CONFIG_UIO_PDRV_GENIRQ=m

# ─── DMA ─────────────────────────────────────────────────────────────────
CONFIG_DMADEVICES=y
CONFIG_DMA_BCM2835=y

# ─── Audio: ALSA core kept on for the bcm2835 HDMI/headphone path ───────
CONFIG_SND=y
CONFIG_SND_PCM=y
CONFIG_SND_BCM2835=m
# Move's primary audio path is XMOS over ablspi, so no SoC codec config
# is required here. Soundcard overlays under /boot/firmware/overlays/
# (hifiberry-*, justboom-*, etc.) ship as kernel modules and remain
# available for users repurposing the carrier.

# ─── Broadcom platform glue ──────────────────────────────────────────────
CONFIG_ARCH_BCM=y
CONFIG_ARCH_BCM2835=y
CONFIG_BCM2835_MBOX=y
CONFIG_RASPBERRYPI_FIRMWARE=y
CONFIG_RASPBERRYPI_POWER=y
CONFIG_BCM2835_POWER=y

# ─── Crypto (SWUpdate signatures, dm-crypt, IPsec) ───────────────────────
CONFIG_CRYPTO=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_USER_API_AEAD=y
CONFIG_CRYPTO_USER_API_RNG=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_AES_ARM64_CE_BLK=y
CONFIG_CRYPTO_CMAC=m
CONFIG_CRYPTO_CCM=m
CONFIG_CRYPTO_CTR=y
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_ECB=y
CONFIG_CRYPTO_CTS=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_SHA1=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_DEFLATE=y
CONFIG_CRYPTO_RSA=y
CONFIG_ASYMMETRIC_KEY_TYPE=y
CONFIG_X509_CERTIFICATE_PARSER=y
CONFIG_PKCS7_MESSAGE_PARSER=y

# ─── Block I/O schedulers (stock had mq-deadline + kyber builtin) ────────
CONFIG_MQ_IOSCHED_DEADLINE=y
CONFIG_MQ_IOSCHED_KYBER=y
CONFIG_BLK_DEV_BSG=y

# ─── devtmpfs, udev, module loading ──────────────────────────────────────
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODVERSIONS=y

# ─── Make /proc/config.gz available on the new kernel ────────────────────
# (Ableton left this off; we turn it on so future archeology is easier.)
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
