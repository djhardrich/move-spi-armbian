// SPDX-License-Identifier: GPL-2.0-or-later
/*
 * ablspi-move-cm5.dts - Device-tree overlay porting the Ableton Move's
 * CM4-era custom bindings forward to Raspberry Pi Compute Module 5 (BCM2712 + RP1).
 *
 * On CM5 the carrier-facing GPIO/SPI/I²C peripherals live on the RP1
 * southbridge (PCIe-attached), not on the BCM2712 SoC. The Pi firmware
 * and upstream rpi linux already expose RP1 controllers under stable DT
 * labels and pre-canned pinctrl groups, so the overlay reduces to:
 *
 *   1. &spi0 -> RP1 spi0 (/axi/pcie@.../rp1/spi@50000). CS0 is wired
 *      to physical SODIMM GPIO 8 in the base DTB's cs-gpios, matching
 *      CM4 BCM2711 spi0 — i.e. the XMOS is on the same physical CS pin
 *      and the ablspi-dkms driver binds cleanly via compatible="ablspi".
 *      &gpio -> RP1 gpio bank (/axi/pcie@.../rp1/gpio@d0000); the
 *      ablspi IRQ on physical GPIO 3 resolves to the same SODIMM pin
 *      as on CM4, so irq-gpios = <&gpio 3 0> is correct unchanged.
 *
 *   2. &spi0 chip-select 1 stays disabled.
 *
 *   3. PCF85063 RTC on the Move carrier's SODIMM GPIO 44/45 pins. On
 *      CM5/RP1 the 44/45 pin pair's I²C alt-function is i2c5 (not the
 *      BCM2711-era i2c0 the CM4 overlay uses). RP1 ships a pre-built
 *      pinctrl group `rp1_i2c5_44_45` with function="i2c5",
 *      pins="gpio44","gpio45", drive-strength=12mA, bias-pull-up — drop
 *      it in and we're done; no manual pin mux required.
 *
 * dwc2 / USB-OTG: not configured here. On CM5 the BCM2712-side USB
 * controller at /axi/usb@480000 is dwc2-compatible (compat string
 * "brcm,bcm2835-usb", status=disabled by default), and the stock
 * dwc2.dtbo's __fixups__ target the &usb label correctly. So
 * `dtoverlay=dwc2,dr_mode=otg` in /boot/firmware/config.txt does the
 * right thing on CM5. The Armbian/family default of dr_mode=host in the
 * [cm5] block must be stripped first (move-bringup.postinst + the
 * Armbian board hook handle that, mirroring the existing CM4
 * otg_mode=1 strip).
 *
 * Build:   dtc -@ -I dts -O dtb -o ablspi-move-cm5.dtbo ablspi-move-cm5.dts
 * Install: copy to /boot/firmware/overlays/ then add
 *              dtoverlay=ablspi-move-cm5
 *          to /boot/firmware/config.txt under [cm5]. Override examples:
 *              dtoverlay=ablspi-move-cm5,ablspi_max_hz=20000000
 */

/dts-v1/;
/plugin/;

/ {
	compatible = "raspberrypi,5-compute-module", "brcm,bcm2712";

	fragment@0 {
		target-path = "/";
		__overlay__ {
			compatible = "ableton,move", "raspberrypi,5-compute-module",
				     "brcm,bcm2712";
			model = "Ableton Move (CM5)";
		};
	};

	/*
	 * SPI0 (RP1): ablspi on CS0, nothing on CS1. We delete the upstream
	 * spidev children the base DTB attaches so our ablspi binding wins
	 * regardless of overlay load order.
	 */
	fragment@1 {
		target = <&spi0>;
		__overlay__ {
			#address-cells = <1>;
			#size-cells = <0>;
			status = "okay";

			/delete-node/ spidev@0;
			/delete-node/ spidev@1;

			ablspi: ablspi@0 {
				compatible = "ablspi";
				reg = <0>;
				spi-max-frequency = <125000000>;

				/*
				 * Modern descriptor-based GPIO binding. &gpio
				 * resolves to RP1's gpio controller; GPIO 3
				 * is the same physical SODIMM pin as on CM4.
				 * See ablspi-move-cm4.dts for the bare-int vs
				 * descriptor rationale.
				 */
				irq-gpios = <&gpio 3 0>;
			};

			ablspi_cs1: spidev@1 {
				compatible = "spidev";
				reg = <1>;
				spi-max-frequency = <125000000>;
				status = "disabled";
			};
		};
	};

	/*
	 * PCF85063 RTC on RP1 i2c5 routed to GPIO 44/45 via the upstream
	 * `rp1_i2c5_44_45` pinctrl group (function="i2c5", pins=44+45,
	 * drive-strength=12mA, bias-pull-up — pre-canned in the CM5 base
	 * DTB, no manual mux required). The RTC reads the BCM2711 carrier's
	 * 44/45 pin pair on CM4 via BSC0; on CM5/RP1 those same physical
	 * pins are reached via designware i2c5 instead. PCB-side: same two
	 * traces, same chip, same address.
	 */
	fragment@2 {
		target = <&i2c5>;
		__overlay__ {
			#address-cells = <1>;
			#size-cells = <0>;
			status = "okay";
			pinctrl-names = "default";
			pinctrl-0 = <&rp1_i2c5_44_45>;
			clock-frequency = <100000>;

			move_rtc: rtc@51 {
				compatible = "nxp,pcf85063";
				reg = <0x51>;
				status = "okay";
			};
		};
	};

	__overrides__ {
		ablspi_max_hz = <&ablspi>,"spi-max-frequency:0";
		rtc_addr      = <&move_rtc>,"reg:0";
	};
};
