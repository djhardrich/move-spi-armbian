// SPDX-License-Identifier: GPL-2.0-or-later
/*
 * ablspi-move-cm5.dts - Device-tree overlay porting the Ableton Move's
 * CM4-era custom bindings forward to Raspberry Pi Compute Module 5 (BCM2712).
 *
 * Apply on top of the stock rpi-6.6.y+ CM5 base DTB. Carries forward exactly
 * the Move additions found in the original move-cm4-complete-devicetree.dtb:
 *
 *   1. &spi0 chip-select 0 is the XMOS link: compatible "ablspi", irq-gpio = 3,
 *      max 125 MHz (the driver clocks at 20 MHz by default).
 *   2. &spi0 chip-select 1 is disabled.
 *   3. PCF85063 RTC on BSC0 via i2c0_gpio44 (GPIO 44/45). The base DTB
 *      label for the BSC0 controller is &i2c0if (NOT &i2c0, which is a
 *      mux child) - matches BCM2711 convention; verify on CM5 hardware.
 *
 * dwc2 OTG: NOT configured here. The Pi firmware mechanism is used
 * instead via `dtoverlay=dwc2,dr_mode=otg` in /boot/firmware/config.txt
 * (added by move-bringup's postinst and the Armbian board hook).
 * The base CM5 DTB does not expose a `&dwc2` label, so targeting it
 * from a DT overlay silently fails the whole overlay apply.
 *
 * Build:   dtc -@ -I dts -O dtb -o ablspi-move-cm5.dtbo ablspi-move-cm5.dts
 * Install: copy to /boot/firmware/overlays/ then add
 *              dtoverlay=ablspi-move-cm5
 *          to /boot/firmware/config.txt. Override examples:
 *              dtoverlay=ablspi-move-cm5,ablspi_irq_gpio=3,ablspi_max_hz=20000000
 */

/dts-v1/;
/plugin/;

/ {
	compatible = "raspberrypi,5-compute-module", "brcm,bcm2712";

	fragment@0 {
		target-path = "/";
		__overlay__ {
			compatible = "ableton,move", "raspberrypi,5-compute-module",
				     "brcm,bcm2712";
			model = "Ableton Move (CM5)";
		};
	};

	/*
	 * SPI0: ablspi on CS0, nothing on CS1. We delete the upstream spidev
	 * children that the rpi-6.6.y base typically attaches so our binding
	 * wins regardless of overlay load order.
	 */
	fragment@1 {
		target = <&spi0>;
		__overlay__ {
			#address-cells = <1>;
			#size-cells = <0>;
			status = "okay";

			/delete-node/ spidev@0;
			/delete-node/ spidev@1;

			ablspi: ablspi@0 {
				compatible = "ablspi";
				reg = <0>;
				spi-max-frequency = <125000000>;

				/*
				 * Modern descriptor-based GPIO binding.
				 * See ablspi-move-cm4.dts for rationale.
				 */
				irq-gpios = <&gpio 3 0>;
			};

			ablspi_cs1: spidev@1 {
				compatible = "spidev";
				reg = <1>;
				spi-max-frequency = <125000000>;
				status = "disabled";
			};
		};
	};

	/*
	 * PCF85063 RTC on BSC0 routed to the same GPIO 44/45 pin pair the
	 * stock Move uses. See ablspi-move-cm4.dts for the full rationale
	 * (avoiding GPIO 3 / I2C1-SCL contention with the ablspi IRQ).
	 * On CM5 the BCM2712 has the same pinctrl group name (`i2c0_gpio44`)
	 * in upstream raspberrypi/linux. If your CM5 kernel exposes it
	 * under a different name, retarget the pinctrl-0 reference below.
	 */
	fragment@3 {
		target = <&i2c0mux>;
		__overlay__ {
			status = "disabled";
		};
	};

	fragment@4 {
		/*
		 * Target &i2c0if, NOT &i2c0. In Armbian's BCM2711 base DTB
		 * (verified on hardware) the labels split as:
		 *   i2c0if -> /soc/i2c@7e205000   (the real BSC0 controller)
		 *   i2c0   -> /soc/i2c0mux/i2c@0  (a mux child node)
		 * Targeting &i2c0 landed on the mux child which has no
		 * status property to flip, and the overlay apply silently
		 * failed. CM5/BCM2712 likely uses the same naming convention
		 * since both come from upstream raspberrypi/linux. If your
		 * CM5 base DTB exposes the controller under a different
		 * label, retarget here.
		 */
		target = <&i2c0if>;
		__overlay__ {
			#address-cells = <1>;
			#size-cells = <0>;
			status = "okay";
			pinctrl-names = "default";
			pinctrl-0 = <&i2c0_gpio44>;
			clock-frequency = <100000>;

			move_rtc: rtc@51 {
				compatible = "nxp,pcf85063";
				reg = <0x51>;
				status = "okay";
			};
		};
	};

	/*
	 * dwc2 / USB-OTG: not configured here. See header comment - the
	 * Pi firmware's runtime mechanism (`dtoverlay=dwc2,dr_mode=otg`
	 * in config.txt) is used instead, because Armbian's CM5 base DTB
	 * does not expose a `&dwc2` label and including the fragment
	 * causes the whole overlay apply to fail silently, taking the
	 * ablspi node down with it.
	 */

	__overrides__ {
		ablspi_irq_gpio = <&ablspi>,"irq-gpio:0";
		ablspi_max_hz   = <&ablspi>,"spi-max-frequency:0";
		rtc_addr        = <&move_rtc>,"reg:0";
	};
};
