[Unit]
Description=Stub UNIX socket at /tmp/swupdateprog for MoveControlModeHandler
Documentation=https://github.com/local/move-bringup
DefaultDependencies=no
After=local-fs.target
Before=move-launcher.service shutdown.target
Conflicts=shutdown.target

[Service]
Type=simple
# Invoke via python3 explicitly so the executable bit on the script
# file is irrelevant — dh_install ships files at mode 0644 by default.
ExecStart=/usr/bin/python3 /usr/lib/move-bringup/swupdateprog-stub.py
Restart=always
RestartSec=1
# The stub binds /tmp/swupdateprog as root (0666). Keep it root because
# /tmp is shared and we want any client to be able to connect.
User=root

[Install]
WantedBy=multi-user.target
